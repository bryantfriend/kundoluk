{
  "manifest_version": 3,
  "name": "Kundoluk Teacher Companion",
  "version": "0.12.1",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "description": "English lesson-plan panel. Import Excel blocks and prepare the current lesson without submitting it.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://kundoluk.edu.gov.kg/mon*"
      ],
      "js": [
        "vendor/jszip.min.js",
        "workbook.js",
        "adapter.js",
        "student-access.js",
        "library.js",
        "event-boundary.js",
        "panel.js",
        "progress.js",
        "progress-panel.js",
        "class-scan.js",
        "classes.js",
        "ui-labels.js",
        "english.js",
        "context-help.js",
        "lesson-focus.js",
        "window.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
